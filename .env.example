# Copy to .env (gitignored). Never commit real keys. Testnet burner wallets only.

# --- contract deployment (contracts/script/Deploy.s.sol) -------------------------------------------
PRIVATE_KEY=
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=46630
ROBINHOOD_EXPLORER_URL=https://explorer.testnet.chain.robinhood.com
USDG_ADDRESS=0x7E955252E15c84f5768B83c41a71F9eba181802F
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# --- backend service (cargoflow serve) -------------------------------------------------------------
# Required
DATABASE_URL=postgres://cargoflow:cargoflow@localhost:5432/cargoflow?sslmode=disable
RPC_URL=https://rpc.testnet.chain.robinhood.com
CHAIN_ID=46630
DEPLOYMENT_FILE=../contracts/deployments/robinhood-testnet.json   # relative to backend/, where make runs the service
ADMIN_API_KEY=            # 16+ characters; guards the administrative endpoints
SALT_SECRET=              # 16+ characters; derives the private salts behind every committed reading
# Role keys. Three DIFFERENT wallets, each holding only its own on-chain role. The service refuses to start
# if the monitor key holds anything beyond MONITOR_ROLE.
WORKER_KEY=               # EVIDENCE_VERIFIER_ROLE: commits evidence epochs
MONITOR_KEY=              # MONITOR_ROLE: may request a pause and nothing else
MANAGER_KEY=              # FACILITY_MANAGER_ROLE: releases milestones, submits recovery proofs
# Optional
HTTP_ADDR=:8080
LOG_LEVEL=info
START_BLOCK=0             # the block the contracts were deployed in
CONFIRMATIONS=1
INDEXER_POLL=2s
RECONCILE_INTERVAL=30s    # retry failed chain actions; 0s disables
CIRCUITS_DIR=../circuits
CORS_ORIGINS=             # comma-separated browser origins, e.g. http://localhost:3000

# --- integrations ----------------------------------------------------------------------------------
# AI monitor (optional). Leave GROQ_API_KEY empty to run on the deterministic policy gate alone.
GROQ_API_KEY=
GROQ_MODEL=               # default openai/gpt-oss-20b
AI_TIMEOUT=10s            # per-epoch model deadline; on expiry the policy gate decides alone
AI_MIN_CONFIDENCE=0.9     # confidence a stricter-than-policy model opinion needs to be honoured
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- tests (optional): enables the database and chain integration tests -----------------------------
# TEST_DATABASE_URL=postgres:///cargoflow_test?host=/run/postgresql
