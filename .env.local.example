# Everything needed to run the whole stack against a local anvil chain:
#   make anvil &  make deploy-local  createdb cargoflow  ENV_FILE=.env.local.example make serve &
#   ENV_FILE=.env.local.example make demo ARGS="-mint -pace 2s"
# These are anvil's PUBLIC development keys. They are worthless on any real network.
DATABASE_URL=postgres:///cargoflow?host=/run/postgresql
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
DEPLOYMENT_FILE=../contracts/deployments/local.json
CIRCUITS_DIR=../circuits
ADMIN_API_KEY=local-admin-key-0123456789
SALT_SECRET=local-salt-secret-0123456789
HTTP_ADDR=127.0.0.1:8787
API_URL=http://127.0.0.1:8787
INDEXER_POLL=200ms
LOG_LEVEL=info

# role wallets: anvil accounts 4, 5 and 0 (the deployer)
WORKER_KEY=0x47e179ec197488593b187f80a00eb0da91f1b9d0b13f8733639f19c30a34926a
MONITOR_KEY=0x8b3a350cf5c34c9194ca85829a2df0ec3153be0318b5e2d3348e872092edffba
MANAGER_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# demo parties: anvil accounts 1, 2 and 3
EXPORTER_KEY=0x59c6995e998f97a5a0044966f0945389dc9e86dae88c7a8412f4603b6b78690d
FINANCIER_KEY=0x5de4111afa1a4b94908f83103eb1f1706367c2e68ca870fc3fb9a804cdab365a
BUYER_KEY=0x7c852118294e51e653712a81e05800f419141751be58f605c371e15141b007a6

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# optional integrations (see .env.example): alerts by Telegram and email, AIS vessel tracking
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
ALERT_EMAIL_FROM=
AISSTREAM_API_KEY=
# gas drip from anvil account 9 (no role, unused elsewhere), 0.00005 ETH per wallet a day
GAS_DRIP_KEY=0x2a871d0798f97d79848a013d4936a73bf4cc922c825d33c1cf7073dff6d409c6
GAS_DRIP_WEI=50000000000000
GAS_DRIP_DAILY=200
