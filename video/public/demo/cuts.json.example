// cuts.json: which parts of public/demo/recording.mp4 go into each 75 s demo shot.
// Copy to cuts.json (node scripts/fit-demo.mjs --init) and replace every in/out with times from YOUR take.
// Comments (//) and trailing commas are allowed.
//
// Finding in/out points:
//   1. node scripts/timecode-proxy.mjs   -> public/demo/recording-proxy.mp4, a small copy with the take's own time
//      burned in big ("00:03:41.233", plus the frame number). Scrub it in any player (VLC, mpv, the browser) and read
//      the time off the picture. Arrow keys step; in mpv "." / "," step one frame.
//   2. Or play the original:  ffplay -vf "drawtext=font=monospace:fontsize=48:box=1:text='%{pts\:hms}'" public/demo/recording.mp4
//   Times are "mm:ss", "mm:ss.sss" or "h:mm:ss.sss", measured from the start of recording.mp4. Aim for 0.1 s; a
//   cut a few frames late only shows a few frames of motion, but keep in-points before a click, not after it.
//
// Fitting rules (each shot fills exactly its window from DEMO-SHOTLIST.md):
//   * A shot may have several segments; they play in the order listed (jump cuts).
//   * No "speed": the segment is flexible. If the shot is too long, flexible segments are sped up together until it fits.
//   * "speed": 1 pins a moment at real speed (a toast, a status pill changing). "speed": 6 forces 6x (a wallet wait).
//   * If the shot is too short, its last frame is held (a frozen frame over 1.5 s gets a warning).
//   Run  node scripts/fit-demo.mjs --dry-run  to check the plan without encoding.
[
  // D1 · 0:00-0:06 (6 s) · Landing hero, scroll one notch, click Exporters
  { "shot": "D1", "in": "00:04.0", "out": "00:10.0" },

  // D2 · 0:06-0:17 (11 s) · Wizard: fill, Continue x3, Sign and submit, three pop-ups, View dashboard
  { "shot": "D2", "in": "00:14.0", "out": "00:18.0", "speed": 1 },   // reference, buyer, invoice
  { "shot": "D2", "in": "00:31.0", "out": "00:33.0", "speed": 1 },   // hover the 2 / 8 °C fields
  { "shot": "D2", "in": "00:44.0", "out": "00:45.5", "speed": 1 },   // "5 tranches of about 4 USDG"
  { "shot": "D2", "in": "00:58.0", "out": "01:34.0" },               // sign + 3 confirmations, auto-ramped
  { "shot": "D2", "in": "01:34.0", "out": "01:35.5", "speed": 1 },   // three green ticks

  // D3 · 0:17-0:23 (6 s) · Financier: approve, deposit, "Facility funded"
  { "shot": "D3", "in": "01:52.0", "out": "02:00.0" },
  { "shot": "D3", "in": "02:16.0", "out": "02:19.0", "speed": 1 },   // toast "Facility funded"

  // D4 · 0:23-0:33 (10 s) · Start transit, add gateway, upload leg-1, Result table, timeline
  { "shot": "D4", "in": "02:40.0", "out": "03:40.0" },
  { "shot": "D4", "in": "04:05.0", "out": "04:07.0", "speed": 1 },   // Result table: 2 x "Passed: milestone released"
  { "shot": "D4", "in": "04:12.0", "out": "04:14.0", "speed": 1 },   // timeline, drawn 8

  // D5 · 0:33-0:42 (9 s) · leg-2, out-of-band warning, "Failed: facility paused", pill turns Paused
  { "shot": "D5", "in": "04:40.0", "out": "04:52.0" },
  { "shot": "D5", "in": "05:03.0", "out": "05:07.0", "speed": 1 },   // the pill change, real speed

  // D6 · 0:42-0:47 (5 s) · /arbiter queue card
  { "shot": "D6", "in": "05:30.0", "out": "05:35.0" },

  // D7 · 0:47-1:00 (13 s) · leg-3, probe-2, sign, prove, submit, "verified on-chain", Active
  { "shot": "D7", "in": "05:58.0", "out": "06:20.0" },
  { "shot": "D7", "in": "06:20.0", "out": "07:15.0", "speed": 40 },  // "Proving, up to a minute…" squeezed
  { "shot": "D7", "in": "07:15.0", "out": "07:20.0", "speed": 1 },   // proof card + Active pill

  // D8 · 1:00-1:06 (6 s) · leg-4, five milestones released
  { "shot": "D8", "in": "07:40.0", "out": "08:10.0" },
  { "shot": "D8", "in": "08:10.0", "out": "08:12.0", "speed": 1 },

  // D9 · 1:06-1:15 (9 s) · Buyer: confirm delivery, approve, pay, Settled, portal card with the split
  { "shot": "D9", "in": "08:30.0", "out": "09:30.0" },
  { "shot": "D9", "in": "09:40.0", "out": "09:44.0", "speed": 1 },   // end on the split card
]
