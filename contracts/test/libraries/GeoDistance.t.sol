        _v(80000000, 0, 79000000, 5000000, 150334545); // 80N to 79N diagonal
        _v(-70000000, -60000000, -71000000, -62000000, 133683399); // 70S Weddell
        _v(18950000, 72950000, 18940782, 72966092, 1978611); // JNPT berth to epoch centroid
        _v(1264000, 103840000, 1300000, 103800000, 5983080); // Singapore approach
        _v(10000000, 20000000, 10008993, 20000000, 999977); // 1 km due north
        _v(0, 0, 0, 8993216, 1000001375); // 1,000 km along the equator
        namedCount = vectors.length;
        _v(-60940818, 905672, -59423871, -2588268, 256399509);
        _v(-63578104, -99617560, -68572032, -104768117, 601429597);
        _v(45339741, 17212124, 45618183, 12539901, 365538963);
        _v(40164153, 31147505, 38518909, 29328431, 240694111);
        _v(-62282153, 114034087, -61424098, 110140458, 225377743);
        _v(29628491, 64580019, 29592587, 66762416, 211014506);
        _v(2174007, -152524836, 736405, -153067509, 170856880);
        _v(-33260500, -15318793, -35167509, -24573087, 876598328);
        _v(12387737, -171093851, 10283714, -168635951, 355720267);
        _v(-12445201, -36441602, -17716152, -36387964, 586132087);
        _v(-61368329, 2289150, -64027298, -2249683, 375323305);
        _v(-1435086, 150031669, -3478600, 151157728, 259384859);
        _v(68197299, -7491612, 70497869, -6382077, 259475636);
        _v(-44076021, -133560413, -44200412, -134160424, 49838814);
        _v(61891945, -143072503, 59135674, -142050873, 311532557);
        _v(-2861902, -97586183, -8413397, -103332478, 886035303);
        _v(-6912585, -11013827, -2745881, -11349064, 464802875);
        _v(7301163, 21526579, 5134642, 27183515, 670084183);
        _v(47968320, 683861, 49561489, -1525040, 239967586);
        _v(-10709307, -74025308, -8335165, -73519037, 269766858);
        _v(24902834, 35018358, 22858476, 34697195, 229655564);
        _v(-1677196, 151743500, -4013423, 151956377, 260850368);
        _v(1802685, 117422464, -1594899, 116130692, 404171670);
        _v(65162596, 119305052, 67592977, 115566375, 317340407);
        _v(-64260162, 68159927, -67773894, 67271565, 392756931);
        _v(-7532687, 167496553, -2711696, 160224226, 967300454);
        _v(-3336600, -156853744, -4541330, -156841753, 133966653);
        _v(-64533993, 89118476, -68024099, 92212498, 411899476);
        _v(-77754793, -179922971, -75334678, 175805561, 290739331);
        _v(-66709509, 105757418, -68277126, 101590301, 248589828);
        _v(40296801, 164292081, 38276523, 161410676, 334570072);
