pragma solidity 0.8.28;

import {Test} from "forge-std/Test.sol";
import {GeoDistance} from "../../src/libraries/GeoDistance.sol";

/// @notice GeoDistance against haversine reference values (float64, sphere of radius 6,371,008.8 m),
///         generated by test/libraries/geo_reference.py and embedded below. The tolerance applied is
///         exactly the accuracy bound stated in the library's NatSpec.
contract GeoDistanceTest is Test {
    struct Vector {
        int32 aLat;
        int32 aLon;
        int32 bLat;
        int32 bLon;
        uint256 refMm; // haversine distance in millimetres
    }

    Vector[] internal vectors;
    uint256 internal namedCount;

    function _v(int32 aLat, int32 aLon, int32 bLat, int32 bLon, uint256 refMm) internal {
        vectors.push(Vector({aLat: aLat, aLon: aLon, bLat: bLat, bLon: bLon, refMm: refMm}));
    }

    function setUp() public {
        _v(18950000, 72950000, 18950000, 72950000, 0); // zero distance (JNPT)
        _v(0, 0, 0, 1000000, 111195080); // equator, 1 deg of longitude
        _v(0, 30000000, 1000000, 30000000, 111195080); // meridian, 1 deg of latitude
        _v(-1000000, 30000000, 1000000, 31000000, 248637233); // equator crossing
        _v(0, 179500000, 0, -179500000, 111195080); // antimeridian on the equator
        _v(60000000, 179800000, 60000000, -179800000, 22238982); // antimeridian at 60N
        _v(52000000, 179000000, 53000000, -178000000, 231497332); // antimeridian, Bering Sea
        _v(-60000000, -179000000, -60500000, 179000000, 123560914); // antimeridian at 60S
        _v(59913900, 10752200, 59329300, 18068600, 416299099); // 60N Oslo-Stockholm
