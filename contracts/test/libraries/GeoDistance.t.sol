        _v(71805146, 25782559, 73597584, 36391969, 402664369);
        _v(3138197, -23901276, 664838, -25655145, 337082441);
        _v(28559729, -154976949, 29150459, -153035269, 200179323);
        _v(67432872, -163714827, 69627561, -175728572, 545221703);
        _v(-7708663, 91695490, -7915558, 90858088, 95076070);
        _v(60450704, -133509680, 61159708, -143189588, 530406590);
        _v(2696426, 164371485, 3103523, 163766251, 81034974);
        _v(-17604570, -26872461, -14313587, -25047797, 414672660);
    }

    // ------------------------------------------------------------------ helpers

    /// The bound stated in GeoDistance's NatSpec, in parts per million of the reference distance.
    function _tolPpm(uint256 maxAbsLatE6, uint256 refMm) internal pure returns (uint256) {
        bool upTo500Km = refMm <= 500_000_000;
        if (maxAbsLatE6 <= 60_000_000) return upTo500Km ? 1_000 : 3_000;
        if (maxAbsLatE6 <= 70_000_000) return upTo500Km ? 2_000 : 7_500;
        return upTo500Km ? 8_000 : 32_000;
    }

    function _abs(int256 x) internal pure returns (uint256) {
        return uint256(x < 0 ? -x : x);
    }

    function _max(uint256 a, uint256 b) internal pure returns (uint256) {
        return a > b ? a : b;
    }

    /// |d - ref| <= tol * ref + 1 m (integer rounding to whole metres)
    function _assertWithinBound(Vector memory v, uint256 dM, string memory label) internal pure {
        uint256 dMm = dM * 1000;
        uint256 diff = dMm > v.refMm ? dMm - v.refMm : v.refMm - dMm;
        uint256 maxLat = _max(_abs(v.aLat), _abs(v.bLat));
        uint256 allowed = (v.refMm * _tolPpm(maxLat, v.refMm)) / 1_000_000 + 1000;
        assertLe(diff, allowed, label);
    }

    /// Wraps a longitude into [-180e6, 180e6).
    function _wrapLon(int256 lon) internal pure returns (int32) {
        int256 span = 360_000_000;
        int256 v = ((lon + 180_000_000) % span + span) % span - 180_000_000;
        // forge-lint: disable-next-line(unsafe-typecast)
        return int32(v); // in [-180e6, 180e6): fits int32
    }

    function _d(Vector memory v) internal pure returns (uint256) {
        return GeoDistance.distanceM(v.aLat, v.aLon, v.bLat, v.bLon);
    }

    // ------------------------------------------------------------------ reference vectors

    function test_namedVectorsMatchHaversineWithinTheStatedBound() public view {
        for (uint256 i; i < namedCount; ++i) {
            _assertWithinBound(vectors[i], _d(vectors[i]), vm.toString(i));
        }
    }

    function test_randomVectorsMatchHaversineWithinTheStatedBound() public view {
        assertEq(vectors.length - namedCount, 48);
        for (uint256 i = namedCount; i < vectors.length; ++i) {
            _assertWithinBound(vectors[i], _d(vectors[i]), vm.toString(i));
        }
    }

    /// Rotating both longitudes, mirroring across the equator and swapping the endpoints leave the
    /// haversine distance unchanged, so every reference vector yields many more, including ones that
    /// straddle the antimeridian at every latitude band.
    function testFuzz_referenceVectorsUnderRotationReflectionAndSwap(
        uint256 index,
        int256 shift,
        bool mirror,
        bool swap
    ) public view {
        Vector memory v = vectors[bound(index, 0, vectors.length - 1)];
        shift = bound(shift, -360_000_000, 360_000_000);
        v.aLon = _wrapLon(int256(v.aLon) + shift);
        v.bLon = _wrapLon(int256(v.bLon) + shift);
        if (mirror) (v.aLat, v.bLat) = (-v.aLat, -v.bLat);
        if (swap) (v.aLat, v.aLon, v.bLat, v.bLon) = (v.bLat, v.bLon, v.aLat, v.aLon);
        _assertWithinBound(v, _d(v), "transformed reference vector");
    }

    // ------------------------------------------------------------------ exact cases

    function test_zeroDistance() public pure {
        assertEq(GeoDistance.distanceM(18_950_000, 72_950_000, 18_950_000, 72_950_000), 0);
        assertEq(GeoDistance.distanceM(-90_000_000, 0, -90_000_000, 0), 0);
    }

    function test_oneDegreeOnTheEquatorAndOnAMeridian() public pure {
        assertEq(GeoDistance.distanceM(0, 0, 0, 1_000_000), 111_195);
        assertEq(GeoDistance.distanceM(0, 30_000_000, 1_000_000, 30_000_000), 111_195);
        assertEq(GeoDistance.distanceM(80_000_000, 5_000_000, 81_000_000, 5_000_000), 111_195);
    }

    function test_antimeridianCrossingTakesTheShortWay() public pure {
        uint256 across = GeoDistance.distanceM(0, 179_500_000, 0, -179_500_000);
        assertEq(across, GeoDistance.distanceM(0, -500_000, 0, 500_000));
        assertEq(across, 111_195);
        assertEq(
            GeoDistance.distanceM(60_000_000, 180_000_000, 60_000_000, -180_000_000),
            0,
            "+180 and -180 are the same meridian"
        );
    }

    function test_longitudeVanishesAtThePole() public pure {
        assertEq(GeoDistance.distanceM(90_000_000, 0, 90_000_000, 180_000_000), 0);
        assertEq(GeoDistance.distanceM(90_000_000, 0, 89_000_000, 0), 111_195);
    }

    function test_radiusBoundaryIsInclusive() public pure {
        // JNPT berth to the real-proof epoch's centroid: 1,978 m
        uint256 d = GeoDistance.distanceM(18_950_000, 72_950_000, 18_940_782, 72_966_092);
        assertEq(d, 1978);
        assertTrue(GeoDistance.withinRadius(18_950_000, 72_950_000, 18_940_782, 72_966_092, 1978));
        assertFalse(GeoDistance.withinRadius(18_950_000, 72_950_000, 18_940_782, 72_966_092, 1977));
        // the largest allowed radius
        assertTrue(GeoDistance.withinRadius(0, 0, 0, 8_993_200, 1_000_000));
        assertFalse(GeoDistance.withinRadius(0, 0, 0, 8_993_300, 1_000_000));
        // the smallest allowed radius
        assertTrue(GeoDistance.withinRadius(10_000_000, 20_000_000, 10_008_993, 20_000_000, 1000));
        assertFalse(GeoDistance.withinRadius(10_000_000, 20_000_000, 10_009_100, 20_000_000, 1000));
    }

    function test_cosineTableEndpointsAndInterpolation() public pure {
        assertEq(GeoDistance.cosE9(0), 1e9);
        assertEq(GeoDistance.cosE9(60_000_000), 500_000_000);
        assertEq(GeoDistance.cosE9(90_000_000), 0);
        assertEq(GeoDistance.cosE9(95_000_000), 0);
        // cos(45.5 deg) = 0.700909264; linear interpolation is within 4e-5 of it
        assertApproxEqAbs(GeoDistance.cosE9(45_500_000), 700_909_264, 40_000);
    }

    function test_coordinateValidation() public pure {
        assertTrue(GeoDistance.isValidCoordinate(90_000_000, 180_000_000));
        assertTrue(GeoDistance.isValidCoordinate(-90_000_000, -180_000_000));
        assertFalse(GeoDistance.isValidCoordinate(90_000_001, 0));
        assertFalse(GeoDistance.isValidCoordinate(-90_000_001, 0));
        assertFalse(GeoDistance.isValidCoordinate(0, 180_000_001));
        assertFalse(GeoDistance.isValidCoordinate(0, -180_000_001));
    }

    // ------------------------------------------------------------------ properties

    function _coord(int256 lat, int256 lon) internal pure returns (int32, int32) {
        // forge-lint: disable-next-line(unsafe-typecast)
        return
            (
                int32(bound(lat, -90_000_000, 90_000_000)),
                int32(bound(lon, -180_000_000, 180_000_000))
            );
    }

    function testFuzz_symmetric(int256 aLat, int256 aLon, int256 bLat, int256 bLon) public pure {
        (int32 la, int32 oa) = _coord(aLat, aLon);
        (int32 lb, int32 ob) = _coord(bLat, bLon);
        assertEq(GeoDistance.distanceM(la, oa, lb, ob), GeoDistance.distanceM(lb, ob, la, oa));
    }

    function testFuzz_samePointIsZero(int256 lat, int256 lon) public pure {
        (int32 la, int32 lo) = _coord(lat, lon);
        assertEq(GeoDistance.distanceM(la, lo, la, lo), 0);
        assertTrue(GeoDistance.withinRadius(la, lo, la, lo, 0));
    }

    /// Rotating both points about the polar axis never changes the result (antimeridian handling).
    function testFuzz_rotationInvariant(
        int256 aLat,
        int256 aLon,
        int256 bLat,
        int256 bLon,
        int256 shift
    ) public pure {
        (int32 la, int32 oa) = _coord(aLat, aLon);
        (int32 lb, int32 ob) = _coord(bLat, bLon);
        shift = bound(shift, -360_000_000, 360_000_000);
        assertEq(
            GeoDistance.distanceM(la, oa, lb, ob),
            GeoDistance.distanceM(la, _wrapLon(oa + shift), lb, _wrapLon(ob + shift))
        );
    }

    /// Along a meridian the haversine is the exact arc R * dLat, which can be computed here.
    function testFuzz_meridianMatchesTheExactArc(int256 aLat, int256 bLat, int256 lon) public pure {
        (int32 la, int32 lo) = _coord(aLat, lon);
        (int32 lb,) = _coord(bLat, 0);
        uint256 arcMm = (_abs(int256(la) - lb) * 111_195_080_234) / 1e9;
        uint256 dMm = GeoDistance.distanceM(la, lo, lb, lo) * 1000;
        assertApproxEqAbs(dMm, arcMm, 1000);
    }

    /// Along the equator the haversine is the exact arc R * dLon (the short way round).
    function testFuzz_equatorMatchesTheExactArc(int256 aLon, int256 bLon) public pure {
        (, int32 oa) = _coord(0, aLon);
        (, int32 ob) = _coord(0, bLon);
        uint256 dLon = _abs(int256(oa) - ob);
        if (dLon > 180_000_000) dLon = 360_000_000 - dLon;
        uint256 arcMm = (dLon * 111_195_080_234) / 1e9;
        assertApproxEqAbs(GeoDistance.distanceM(0, oa, 0, ob) * 1000, arcMm, 1000);
    }

    function testFuzz_cosineIsMonotonicAndBounded(uint256 x, uint256 y) public pure {
        x = bound(x, 0, 90_000_000);
        y = bound(y, x, 90_000_000);
        assertGe(GeoDistance.cosE9(x), GeoDistance.cosE9(y));
        assertLe(GeoDistance.cosE9(x), 1e9);
    }

    function testFuzz_withinRadiusAgreesWithDistance(
        int256 aLat,
        int256 aLon,
        int256 bLat,
        int256 bLon,
        uint32 radiusM
    ) public pure {
        (int32 la, int32 oa) = _coord(aLat, aLon);
        (int32 lb, int32 ob) = _coord(bLat, bLon);
        assertEq(
            GeoDistance.withinRadius(la, oa, lb, ob, radiusM),
            GeoDistance.distanceM(la, oa, lb, ob) <= radiusM
        );
    }

    /// No input in range can overflow: the result never exceeds half the equator plus the meridian.
    function testFuzz_neverRevertsAndIsBounded(int256 aLat, int256 aLon, int256 bLat, int256 bLon)
        public
        pure
    {
        (int32 la, int32 oa) = _coord(aLat, aLon);
        (int32 lb, int32 ob) = _coord(bLat, bLon);
        assertLe(GeoDistance.distanceM(la, oa, lb, ob), 20_015_087 + 20_015_087);
    }
}
