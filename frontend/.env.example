# Copy to .env.local. All values are public (they are compiled into the browser bundle).
NEXT_PUBLIC_API_URL=http://127.0.0.1:8080
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# 1 only for Playwright: adds a mock wallet backed by anvil's unlocked dev accounts
NEXT_PUBLIC_E2E=0
# RPC of the local anvil chain (only used when the backend reports chain 31337)
NEXT_PUBLIC_LOCAL_RPC_URL=http://127.0.0.1:8545
